# Runs a command in the pypa manylinux_2_28 aarch64 image, the way the generated wrappers in
# ../dockcross do for x86-64: the repository is mounted at /work, which is the working directory,
# the command runs as the calling user (so the tree it writes belongs to the runner, not root), and
# MANYLINUX_ARGS passes extra `docker run` arguments, e.g. `-e NAME` to forward an environment
# variable (the counterpart of DOCKCROSS_ARGS).
#
# Why this image and not dockcross's: dockcross/manylinux_2_28-aarch64 is a CROSS toolchain -- an
# amd64 image carrying a crosstool-NG gcc for aarch64 -- while quay.io/pypa/manylinux_2_28_aarch64
# is native arm64 and runs on GitHub's ubuntu-24.04-arm runner, so the build is a native one.
# Contents (checked 2026-10-08): AlmaLinux 8, glibc 2.28, gcc-toolset-14 (GCC 14.2.1, on PATH),
# cmake 4.x, git, curl -- everything build.sh needs, including its sccache fetch for aarch64.
#
# Pinned by digest, tag 2026.10.03-1. Bump it deliberately, with a Publish run: the image decides
# the artifact's glibc floor (verify-native-deps.py holds Linux/aarch64/cpu to GLIBC_2.28) and
# its compiler.
#
# Usage: .github/manylinux/manylinux_2_28-aarch64 <command> [args...]
set -euo pipefail

IMAGE="quay.io/pypa/manylinux_2_28_aarch64@sha256:f5f03dedf61b47d69d0742d36047db78adeee3bdb7a9910ff52304750ecf2514"

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <command> [args...]" >&2
  exit 2
fi

# HOME: the calling uid has no account inside the image; git and sccache want a writable home.
# shellcheck disable=SC2086 # MANYLINUX_ARGS is a list of docker run arguments by design
exec docker run --rm \
  -v "$PWD":/work -w /work \
  -u "$(id -u):$(id -g)" -e HOME=/tmp \
  ${MANYLINUX_ARGS:-} \
  "$IMAGE" "$@"
