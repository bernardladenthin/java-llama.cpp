{
  "$comment": "Configuration of the shared checks of bernardladenthin/actions (see its README).",
  "templates": {
    "sets": [
      "common",
      "java"
    ],
    "relocate": {
      "lombok.config": "llama/lombok.config"
    },
    "exclude": [
      ".github/workflows/sonarqube.yml",
      ".mvn/settings.xml",
      "CITATION.cff"
    ]
  },
  "maven-versions": {
    "poms": [
      "pom.xml",
      "llama/pom.xml",
      "llama-langchain4j/pom.xml",
      "llama-kotlin/pom.xml",
      "llama-ffm/pom.xml",
      "llama-platform/pom.xml",
      "llama-atmosphere-agent/pom.xml",
      "examples/server/pom.xml"
    ],
    "family": "java-maven",
    "ignore-groups": [
      "net.ladenthin"
    ]
  },
  "post-release": {
    "$comment": "bernardladenthin/actions java/audit-publication (.github/workflows/post-release.yml): the release key's primary fingerprint, and the class-file floor of each artifact (CLAUDE.md, \"Java 8 bytecode floor\"; first match wins).",
    "signing-key": "EA6E1AC27DB005538E971E85ED0D9440BF148ED2",
    "bytecode": [
      {
        "files": "llama-ffm-*.jar",
        "major": 66
      },
      {
        "files": "llama-langchain4j-*.jar",
        "major": 61
      },
      {
        "files": "llama-atmosphere-agent-*.jar",
        "major": 65
      },
      {
        "files": "*",
        "major": 52
      }
    ]
  }
}
