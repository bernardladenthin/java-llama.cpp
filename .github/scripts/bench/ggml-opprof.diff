Measurement-only instrumentation of ggml's CPU graph loop: per (op, src0 type) the summed thread time
inside the op and inside the barrier after it, printed at exit as OPPROF lines. Compiled in only with
-DGGML_OPPROF (CMAKE_C_FLAGS), never shipped. Applies to llama.cpp b11887 + llama/patches/ with
`git apply`; docs/benchmarks/moe-mxfp4-cpu-alderlake.md is what it was used for.

--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3108,6 +3108,34 @@
     return 0;
 }
 
+
+#ifdef GGML_OPPROF
+// per (op, src0 type): summed thread time in the op and in the barrier after it (benchmark-only)
+#include <stdatomic.h>
+#define OPPROF_N (GGML_OP_COUNT * GGML_TYPE_COUNT)
+static _Atomic int64_t opprof_cmp[OPPROF_N], opprof_wait[OPPROF_N], opprof_cnt[OPPROF_N];
+static atomic_int opprof_registered;
+static int64_t opprof_now(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (int64_t) ts.tv_sec * 1000000000LL + ts.tv_nsec; }
+static void opprof_dump(void) {
+    int64_t tot = 0;
+    for (int i = 0; i < OPPROF_N; i++) tot += opprof_cmp[i] + opprof_wait[i];
+    if (!tot) return;
+    int idx[OPPROF_N]; int n = 0;
+    for (int i = 0; i < OPPROF_N; i++) if (opprof_cnt[i]) idx[n++] = i;
+    for (int a = 0; a < n; a++) for (int b = a + 1; b < n; b++)
+        if (opprof_cmp[idx[b]] + opprof_wait[idx[b]] > opprof_cmp[idx[a]] + opprof_wait[idx[a]]) { int t = idx[a]; idx[a] = idx[b]; idx[b] = t; }
+    int64_t wtot = 0; for (int i = 0; i < OPPROF_N; i++) wtot += opprof_wait[i];
+    fprintf(stderr, "OPPROF total thread-ms %.1f, of it barrier wait %.1f (%.1f%%)\n", tot / 1e6, wtot / 1e6, 100.0 * wtot / tot);
+    fprintf(stderr, "OPPROF %-16s %-8s %10s %9s %9s %7s %7s\n", "op", "src0", "nodes/thr", "cmp-ms", "wait-ms", "cmp%", "wait%");
+    for (int a = 0; a < n && a < 30; a++) {
+        int i = idx[a];
+        fprintf(stderr, "OPPROF %-16s %-8s %10lld %9.1f %9.1f %6.1f%% %6.1f%%\n", ggml_op_name((enum ggml_op)(i / GGML_TYPE_COUNT)),
+                ggml_type_name((enum ggml_type)(i % GGML_TYPE_COUNT)), (long long) opprof_cnt[i], opprof_cmp[i] / 1e6, opprof_wait[i] / 1e6,
+                100.0 * opprof_cmp[i] / tot, 100.0 * opprof_wait[i] / tot);
+    }
+}
+#endif
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3150,12 +3178,20 @@
 
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
+#ifdef GGML_OPPROF
+        if (!atomic_exchange(&opprof_registered, 1)) atexit(opprof_dump);
+        const int opprof_key = node->op * GGML_TYPE_COUNT + (node->src[0] ? node->src[0]->type : 0);
+        const int64_t opprof_t0 = opprof_now();
+#endif
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
         if (n_fused > 0) {
             node_n += n_fused;
         } else {
             ggml_compute_forward(&params, node);
         }
+#ifdef GGML_OPPROF
+        const int64_t opprof_t1 = opprof_now();
+#endif
 
         if (state->ith == 0 && cplan->abort_callback &&
                 cplan->abort_callback(cplan->abort_callback_data)) {
@@ -3166,6 +3202,12 @@
         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
         }
+#ifdef GGML_OPPROF
+        const int64_t opprof_t2 = opprof_now();
+        opprof_cmp[opprof_key] += opprof_t1 - opprof_t0;
+        opprof_wait[opprof_key] += opprof_t2 - opprof_t1;
+        opprof_cnt[opprof_key] += 1;
+#endif
     }
 
 #ifdef GGML_USE_OPENMP
