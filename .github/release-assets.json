{
  "schema": 1,
  "maven": {
    "standalone": [
      "llama-atmosphere-agent"
    ],
    "cyclonedx": true
  },
  "files": [
    {
      "source": "llama/target/llama-{version}-{classifier}.jar",
      "classifiers": {
        "csv": ".github/natives.csv",
        "column": "classifier"
      }
    },
    {
      "source": "llama-source-archive/llama.cpp-*-jllama-{version}-src.tar.gz"
    },
    {
      "source": "llama-android/build/aar/llama-android-{version}.aar"
    },
    {
      "source": "llama-android/build/publications/llamaAndroid/pom-default.xml",
      "name": "llama-android-{version}.pom"
    },
    {
      "source": "llama-android/build/distributions/llama-android-{version}-{classifier}.jar",
      "name": "llama-android-{version}-{classifier}.jar",
      "classifiers": [
        "sources",
        "javadoc"
      ]
    },
    {
      "source": "llama-android/build/aar/llama-android-opencl-{version}.aar"
    },
    {
      "source": "llama-android/build/publications/llamaAndroidOpencl/pom-default.xml",
      "name": "llama-android-opencl-{version}.pom"
    },
    {
      "source": "llama-android/build/distributions/llama-android-{version}-{classifier}.jar",
      "name": "llama-android-opencl-{version}-{classifier}.jar",
      "classifiers": [
        "sources",
        "javadoc"
      ]
    }
  ]
}
