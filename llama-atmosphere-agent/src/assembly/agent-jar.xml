<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <!--
      The agent's release asset: the agent plus everything it needs that a core fat jar does
      NOT already carry (Atmosphere, Jackson 3, SnakeYAML, JLine) - a few MB instead of the
      hundreds of MB of natives every core fat jar holds.

      Excluded, because the core fat jar it runs next to supplies them:
        - net.ladenthin:llama and its whole runtime graph (Jackson 2, slf4j-api), via
          useTransitiveFiltering. That includes jackson-annotations, which Jackson 3 resolves
          through the core's trail as well.
        - jspecify and slf4j-simple, which the core fat jar also bundles (and slf4j-simple's
          simplelogger.properties with it). Two SLF4J providers on one classpath is exactly
          what must not happen.

      The manifest's Class-Path (see the pom) names the core fat jars, so `java -jar` works
      when the agent jar lies next to one of them.
    -->
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
            <useTransitiveFiltering>true</useTransitiveFiltering>
            <excludes>
                <exclude>net.ladenthin:llama</exclude>
                <exclude>org.jspecify:jspecify</exclude>
                <exclude>org.slf4j:slf4j-simple</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
