<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Standalone (NOT a reactor module, NEVER on Maven Central): a local coding agent that wires
		Atmosphere's built-in OpenAI-compatible agent runtime to java-llama.cpp. CI builds and tests
		it against the freshly installed core (-Dllama.version=<reactor version>) and attaches the
		`-P assembly` jar (without the core, see src/assembly/agent-jar.xml) to the GitHub Release
		next to the core fat jars. A user either downloads that jar or copies the folder and runs
		it with `mvn compile exec:java` against the released core the llama.version default names.
		See README.md.
	-->
	<groupId>net.ladenthin</groupId>
	<artifactId>llama-atmosphere-agent</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>Local JVM coding agent: Atmosphere's built-in OpenAI-compatible agent runtime
		(tool calling, streaming) driven against java-llama.cpp's OpenAI-compatible server.</description>
	<url>https://github.com/bernardladenthin/java-llama.cpp</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://www.opensource.org/licenses/mit-license.php</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Atmosphere requires Java 21; the core net.ladenthin:llama stays Java 8. -->
		<maven.compiler.release>21</maven.compiler.release>
		<!-- The java-llama.cpp release this project is documented against (the README's commands
		     run without any -D). CI overrides it with the reactor version it just installed; anyone
		     else can override it too, e.g. -Dllama.version=5.3.0-SNAPSHOT for a pre-release core.
		     Bump it as part of every release. -->
		<llama.version>5.2.0</llama.version>
		<atmosphere.version>4.0.71</atmosphere.version>
		<jline.version>4.4.6</jline.version>
		<jetty.version>12.1.13</jetty.version>
		<acp.version>0.18.0</acp.version>
		<slf4j.version>2.0.20</slf4j.version>
		<jspecify.version>1.0.1</jspecify.version>
		<junit.version>6.1.3</junit.version>
		<hamcrest.version>3.0</hamcrest.version>
		<compiler.plugin.version>3.16.0</compiler.plugin.version>
		<surefire.version>3.6.0</surefire.version>
		<exec.plugin.version>3.6.4</exec.plugin.version>
		<assembly.plugin.version>3.8.0</assembly.plugin.version>
		<spotless.version>3.10.3</spotless.version>
		<palantir-java-format.version>2.99.0</palantir-java-format.version>
		<agent.main>net.ladenthin.llama.atmosphere.LocalAgent</agent.main>
	</properties>

	<!-- Only consulted for a -SNAPSHOT llama.version override (releases come from Maven Central). -->
	<repositories>
		<repository>
			<id>sonatype-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<!-- The model server (in-process mode) and the OpenAI-compatible HTTP surface under test: the
		     classes. The natives come from the natives / gpu-natives profiles below. -->
		<dependency>
			<groupId>net.ladenthin</groupId>
			<artifactId>llama</artifactId>
			<version>${llama.version}</version>
		</dependency>

		<!-- Atmosphere's built-in OpenAI-compatible agent runtime: streaming, tool loop, file tools.
		     No Spring Boot, no servlet container: BuiltInAgentRuntime is driven headless. -->
		<dependency>
			<groupId>org.atmosphere</groupId>
			<artifactId>atmosphere-ai</artifactId>
			<version>${atmosphere.version}</version>
		</dependency>

		<!-- The terminal: line editing, history, tab completion, a pinned status line and single-key
		     answers. One jar, no transitive dependencies; the agent falls back to a plain stream
		     whenever JLine finds no usable terminal (piped input, tests, one-shot runs). -->
		<dependency>
			<groupId>org.jline</groupId>
			<artifactId>jline</artifactId>
			<version>${jline.version}</version>
		</dependency>

		<!-- The browser front end (the web option): Atmosphere's servlet on an embedded Jetty 12, no Spring.
		     jetty-ee10-annotations is excluded because the endpoint is registered explicitly: it
		     would pull in CDI, JNDI, XML and ASM for classpath scanning that never runs. -->
		<dependency>
			<groupId>org.eclipse.jetty.ee10</groupId>
			<artifactId>jetty-ee10-servlet</artifactId>
			<version>${jetty.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jetty.ee10.websocket</groupId>
			<artifactId>jetty-ee10-websocket-jakarta-server</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.eclipse.jetty.ee10</groupId>
					<artifactId>jetty-ee10-annotations</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Only for the prebuilt Atmosphere AI Console it carries under META-INF/resources: every
		     transitive dependency (Spring Boot) is excluded, so no Spring class is on the classpath. -->
		<dependency>
			<groupId>org.atmosphere</groupId>
			<artifactId>atmosphere-spring-boot-starter</artifactId>
			<version>${atmosphere.version}</version>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- The editor front end (the acp option): the official Java SDK of the Agent Client Protocol,
		     spoken over stdin/stdout. Jackson 2 binding, which the core fat jar already carries. -->
		<dependency>
			<groupId>com.agentclientprotocol</groupId>
			<artifactId>acp-core</artifactId>
			<version>${acp.version}</version>
		</dependency>
		<dependency>
			<groupId>com.agentclientprotocol</groupId>
			<artifactId>acp-json-jackson2</artifactId>
			<version>${acp.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>${jspecify.version}</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>${slf4j.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hamcrest</groupId>
			<artifactId>hamcrest</artifactId>
			<version>${hamcrest.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${compiler.plugin.version}</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${surefire.version}</version>
				<configuration>
					<!-- Model-backed tests self-skip without a GGUF; the wire-contract tests need
					     nothing. Keep the fork on the classpath (the core jar carries a module-info). -->
					<useModulePath>false</useModulePath>
					<trimStackTrace>false</trimStackTrace>
				</configuration>
			</plugin>
			<!-- `mvn compile exec:java -Dexec.args="..."` runs the agent from the source tree. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${exec.plugin.version}</version>
				<configuration>
					<mainClass>${agent.main}</mainClass>
					<!-- Fail the Maven build with the agent's exit code instead of swallowing it. -->
					<cleanupDaemonThreads>false</cleanupDaemonThreads>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
						</palantirJavaFormat>
					</java>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!--
			The core's CPU natives of every desktop platform (macOS: Metal), so the README's commands
			run anywhere. Active unless -Dllama.natives=none, which CI passes: it installs only the
			core classes, and its model-backed job points the loader at a downloaded library with
			-Dnet.ladenthin.llama.lib.path instead.
		-->
		<profile>
			<id>natives</id>
			<activation>
				<property>
					<name>llama.natives</name>
					<value>!none</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama-platform</artifactId>
					<version>${llama.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
		</profile>
		<!--
			A GPU backend next to the CPU natives: -Dllama.classifier=<natives jar>, e.g.
			cuda13-linux-x86-64 or vulkan-windows-x86-64 (the vendor runtime must be installed). The
			loader prefers it and falls back to the CPU natives when it does not load.
		-->
		<profile>
			<id>gpu-natives</id>
			<activation>
				<property>
					<name>llama.classifier</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>${llama.classifier}</classifier>
				</dependency>
			</dependencies>
		</profile>
		<!--
			`mvn -P assembly package`: the GitHub Release asset
			llama-atmosphere-agent-<llama.version>-jar-with-dependencies.jar. Named after the core
			version it was built and tested against (the agent's own 1.0.0-SNAPSHOT is not a
			release line anyone downloads by). It carries NO core: run it next to a core fat jar of
			the same version, either on one explicit classpath
			  java -cp agent.jar:llama-<v>-all-linux-x86-64-jar-with-dependencies.jar ...LocalAgent
			or with `java -jar agent.jar`, which picks the core up through the Class-Path below when
			it lies in the same directory. Class-Path entries that do not exist are ignored; the
			all-backends jars come first so a GPU backend is found before the CPU-only default.
		-->
		<profile>
			<id>assembly</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>${assembly.plugin.version}</version>
						<configuration>
							<finalName>llama-atmosphere-agent-${llama.version}</finalName>
							<descriptors>
								<descriptor>src/assembly/agent-jar.xml</descriptor>
							</descriptors>
							<archive>
								<manifest>
									<mainClass>${agent.main}</mainClass>
								</manifest>
								<manifestEntries>
									<Class-Path>llama-${llama.version}-all-linux-x86-64-jar-with-dependencies.jar llama-${llama.version}-all-linux-aarch64-jar-with-dependencies.jar llama-${llama.version}-all-windows-x86-64-jar-with-dependencies.jar llama-${llama.version}-all-windows-aarch64-jar-with-dependencies.jar llama-${llama.version}-jar-with-dependencies.jar</Class-Path>
								</manifestEntries>
							</archive>
						</configuration>
						<executions>
							<execution>
								<id>build-agent-jar</id>
								<phase>package</phase>
								<goals>
									<goal>single</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
