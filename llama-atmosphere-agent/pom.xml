<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Standalone (NOT a reactor module): a local coding agent that wires Atmosphere's built-in
		OpenAI-compatible agent runtime to java-llama.cpp. Not in the reactor because it is an
		application, built without a parent so the folder can be copied out and run on its own.
		Its version moves in lockstep with the core's (check-natives.py fails otherwise), and it
		ships two ways: this thin jar + pom on Maven Central (`jbang net.ladenthin:llama-atmosphere-agent:<v>`
		resolves and starts it, natives included through llama-platform), and the `-P assembly` jar
		(without the core, see src/assembly/agent-jar.xml) on the GitHub Release next to the core
		fat jars. See README.md.
	-->
	<groupId>net.ladenthin</groupId>
	<artifactId>llama-atmosphere-agent</artifactId>
	<version>5.2.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>Local JVM coding agent: Atmosphere's built-in OpenAI-compatible agent runtime
		(tool calling, streaming) driven against java-llama.cpp's OpenAI-compatible server.</description>
	<url>https://github.com/bernardladenthin/java-llama.cpp</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://www.opensource.org/licenses/mit-license.php</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Bernard Ladenthin</name>
			<organizationUrl>https://github.com/bernardladenthin</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/bernardladenthin/java-llama.cpp.git</connection>
		<developerConnection>scm:git:https://github.com/bernardladenthin/java-llama.cpp.git</developerConnection>
		<url>https://github.com/bernardladenthin/java-llama.cpp/tree/main</url>
	</scm>

	<distributionManagement>
		<snapshotRepository>
			<id>central</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Atmosphere requires Java 21; the core net.ladenthin:llama stays Java 8. -->
		<maven.compiler.release>21</maven.compiler.release>
		<!-- The core this agent runs on: the same version as the agent, which moves in lockstep with
		     the java-llama.cpp reactor. Overridable, e.g. -Dllama.version=5.3.0-SNAPSHOT to try a
		     newer core from the snapshot repository below. -->
		<llama.version>${project.version}</llama.version>
		<atmosphere.version>4.0.72</atmosphere.version>
		<jline.version>4.4.7</jline.version>
		<jetty.version>12.1.14</jetty.version>
		<acp.version>0.18.0</acp.version>
		<slf4j.version>2.0.20</slf4j.version>
		<jspecify.version>1.0.1</jspecify.version>
		<junit.version>6.1.3</junit.version>
		<hamcrest.version>3.0</hamcrest.version>
		<compiler.plugin.version>3.16.0</compiler.plugin.version>
		<surefire.version>3.6.0</surefire.version>
		<resources.plugin.version>3.5.0</resources.plugin.version>
		<jar.plugin.version>3.5.1</jar.plugin.version>
		<source.plugin.version>3.4.0</source.plugin.version>
		<javadoc.plugin.version>3.12.0</javadoc.plugin.version>
		<gpg.plugin.version>3.2.8</gpg.plugin.version>
		<central.publishing.version>0.11.0</central.publishing.version>
		<exec.plugin.version>3.6.4</exec.plugin.version>
		<assembly.plugin.version>3.8.0</assembly.plugin.version>
		<spotless.version>3.10.3</spotless.version>
		<palantir-java-format.version>2.102.0</palantir-java-format.version>
		<agent.main>net.ladenthin.llama.atmosphere.LocalAgent</agent.main>
	</properties>

	<!-- Only consulted for a -SNAPSHOT core (releases come from Maven Central). -->
	<repositories>
		<repository>
			<id>sonatype-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<!-- The model server (in-process mode) and the OpenAI-compatible HTTP surface under test: the
		     classes. -->
		<dependency>
			<groupId>net.ladenthin</groupId>
			<artifactId>llama</artifactId>
			<version>${llama.version}</version>
		</dependency>
		<!-- The natives: the CPU natives jar of every desktop platform (macOS: Metal), so the agent runs
		     anywhere without a further choice. A plain dependency and not a profile, because it is part
		     of the published pom: a consumer resolving the agent from Maven Central (JBang, Maven) must
		     get it regardless of how that tool treats profiles. A GPU backend is an addition, see the
		     gpu-natives profile; CI, which installs only the classes, drops this with -Dllama.natives=none. -->
		<dependency>
			<groupId>net.ladenthin</groupId>
			<artifactId>llama-platform</artifactId>
			<version>${llama.version}</version>
			<type>pom</type>
			<scope>runtime</scope>
		</dependency>

		<!-- Atmosphere's built-in OpenAI-compatible agent runtime: streaming, tool loop, file tools.
		     No Spring Boot, no servlet container: BuiltInAgentRuntime is driven headless. -->
		<dependency>
			<groupId>org.atmosphere</groupId>
			<artifactId>atmosphere-ai</artifactId>
			<version>${atmosphere.version}</version>
		</dependency>

		<!-- The terminal: line editing, history, tab completion, a pinned status line and single-key
		     answers. One jar, no transitive dependencies; the agent falls back to a plain stream
		     whenever JLine finds no usable terminal (piped input, tests, one-shot runs). -->
		<dependency>
			<groupId>org.jline</groupId>
			<artifactId>jline</artifactId>
			<version>${jline.version}</version>
		</dependency>

		<!-- The browser front end (the web option): Atmosphere's servlet on an embedded Jetty 12, no Spring.
		     jetty-ee10-annotations is excluded because the endpoint is registered explicitly: it
		     would pull in CDI, JNDI, XML and ASM for classpath scanning that never runs. -->
		<dependency>
			<groupId>org.eclipse.jetty.ee10</groupId>
			<artifactId>jetty-ee10-servlet</artifactId>
			<version>${jetty.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jetty.ee10.websocket</groupId>
			<artifactId>jetty-ee10-websocket-jakarta-server</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.eclipse.jetty.ee10</groupId>
					<artifactId>jetty-ee10-annotations</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Only for the prebuilt Atmosphere AI Console it carries under META-INF/resources: every
		     transitive dependency (Spring Boot) is excluded, so no Spring class is on the classpath. -->
		<dependency>
			<groupId>org.atmosphere</groupId>
			<artifactId>atmosphere-spring-boot-starter</artifactId>
			<version>${atmosphere.version}</version>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- The editor front end (the acp option): the official Java SDK of the Agent Client Protocol,
		     spoken over stdin/stdout. Jackson 2 binding, which the core fat jar already carries. -->
		<dependency>
			<groupId>com.agentclientprotocol</groupId>
			<artifactId>acp-core</artifactId>
			<version>${acp.version}</version>
		</dependency>
		<dependency>
			<groupId>com.agentclientprotocol</groupId>
			<artifactId>acp-json-jackson2</artifactId>
			<version>${acp.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>${jspecify.version}</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>${slf4j.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hamcrest</groupId>
			<artifactId>hamcrest</artifactId>
			<version>${hamcrest.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${compiler.plugin.version}</version>
			</plugin>
			<!-- Pinned although unconfigured: otherwise the default of whatever Maven runs the build
			     applies, which differs between CI and a local build. Same versions as the reactor. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>${resources.plugin.version}</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${jar.plugin.version}</version>
				<configuration>
					<!-- The published thin jar names its entry point, so `jbang <coordinates>` starts it;
					     its classpath comes from the pom, never from a Class-Path entry. -->
					<archive>
						<manifest>
							<mainClass>${agent.main}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${surefire.version}</version>
				<configuration>
					<!-- Model-backed tests self-skip without a GGUF; the wire-contract tests need
					     nothing. Keep the fork on the classpath (the core jar carries a module-info). -->
					<useModulePath>false</useModulePath>
					<trimStackTrace>false</trimStackTrace>
				</configuration>
			</plugin>
			<!-- `mvn compile exec:java -Dexec.args="..."` runs the agent from the source tree. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${exec.plugin.version}</version>
				<configuration>
					<mainClass>${agent.main}</mainClass>
					<!-- Fail the Maven build with the agent's exit code instead of swallowing it. -->
					<cleanupDaemonThreads>false</cleanupDaemonThreads>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
						</palantirJavaFormat>
					</java>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!--
			-Dllama.natives=none: build without the natives, which CI does: it installs only the
			core classes and the llama-platform pom (no natives jar exists before the package job),
			and its model-backed job points the loader at a downloaded library with
			-Dnet.ladenthin.llama.lib.path. The dependency stays; the exclusion keeps Maven from
			resolving what llama-platform names, so only its pom has to be there.
		-->
		<profile>
			<id>no-natives</id>
			<activation>
				<property>
					<name>llama.natives</name>
					<value>none</value>
				</property>
			</activation>
			<dependencyManagement>
				<dependencies>
					<dependency>
						<groupId>net.ladenthin</groupId>
						<artifactId>llama-platform</artifactId>
						<version>${llama.version}</version>
						<type>pom</type>
						<exclusions>
							<exclusion>
								<groupId>*</groupId>
								<artifactId>*</artifactId>
							</exclusion>
						</exclusions>
					</dependency>
				</dependencies>
			</dependencyManagement>
		</profile>
		<!--
			A GPU backend next to the CPU natives: -Dllama.classifier=<natives jar>, e.g.
			cuda13-linux-x86-64 or vulkan-windows-x86-64 (the vendor runtime must be installed). The
			loader prefers it and falls back to the CPU natives when it does not load.
		-->
		<profile>
			<id>gpu-natives</id>
			<activation>
				<property>
					<name>llama.classifier</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>${llama.classifier}</classifier>
				</dependency>
			</dependencies>
		</profile>
		<!--
			`mvn -P assembly package`: the GitHub Release asset
			llama-atmosphere-agent-<llama.version>-jar-with-dependencies.jar. Named after the core
			version it was built and tested against (the agent's own 1.0.0-SNAPSHOT is not a
			release line anyone downloads by). It carries NO core: run it next to a core fat jar of
			the same version, either on one explicit classpath
			  java -cp agent.jar:llama-<v>-all-linux-x86-64-jar-with-dependencies.jar ...LocalAgent
			or with `java -jar agent.jar`, which picks the core up through the Class-Path below when
			it lies in the same directory. Class-Path entries that do not exist are ignored; the
			all-backends jars come first so a GPU backend is found before the CPU-only default.
		-->
		<profile>
			<id>assembly</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>${assembly.plugin.version}</version>
						<configuration>
							<finalName>llama-atmosphere-agent-${llama.version}</finalName>
							<descriptors>
								<descriptor>src/assembly/agent-jar.xml</descriptor>
							</descriptors>
							<archive>
								<manifest>
									<mainClass>${agent.main}</mainClass>
								</manifest>
								<manifestEntries>
									<Class-Path>llama-${llama.version}-all-linux-x86-64-jar-with-dependencies.jar llama-${llama.version}-all-linux-aarch64-jar-with-dependencies.jar llama-${llama.version}-all-windows-x86-64-jar-with-dependencies.jar llama-${llama.version}-all-windows-aarch64-jar-with-dependencies.jar llama-${llama.version}-jar-with-dependencies.jar</Class-Path>
								</manifestEntries>
							</archive>
						</configuration>
						<executions>
							<execution>
								<id>build-agent-jar</id>
								<phase>package</phase>
								<goals>
									<goal>single</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
			`-P release deploy`: signs the thin jar, its sources and javadoc jars and the pom, and
			publishes them to Maven Central. Run by the publish jobs after the reactor deploy, which
			installs the core and its natives jars this resolves against. The assembly jar is never
			part of it.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>${source.plugin.version}</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals><goal>jar-no-fork</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>${javadoc.plugin.version}</version>
						<configuration>
							<doclint>all,-missing</doclint>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals><goal>jar</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${gpg.plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals><goal>sign</goal></goals>
								<configuration>
									<keyname>${gpg.keyname}</keyname>
									<gpgArguments>
										<arg>--pinentry-mode</arg>
										<arg>loopback</arg>
									</gpgArguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central.publishing.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
							<waitUntil>validated</waitUntil>
							<waitMaxTime>21600</waitMaxTime>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
