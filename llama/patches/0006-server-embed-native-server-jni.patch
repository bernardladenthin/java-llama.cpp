server: make llama_server() embeddable in a host process (no signal handlers, forwarded argv, stoppable)

b9870 exposes int llama_server(int, char **) with no main() in server.cpp; this patch adds what a
JVM host needs to run it inside libjllama: a g_llama_server_embedded flag with
llama_server_set_embedded() / llama_server_request_shutdown() (declared by the host in
native_server_bridge.h), no process-wide SIGINT/SIGTERM handlers in embedded mode (they would
hijack the JVM's), common_params_parse instead of common_params_parse_main for the forwarded argv
(the latter's GetCommandLineW recovery would pick up java.exe's command line, the class of defect
0001 fixes), and a shutdown handler guarded by g_shutdown_handler_mutex and reset before the locals
it captures are destroyed -- a request landing after llama_server() returned used to run the lambda
over destroyed objects (SIGSEGV in server_http_context::stop(), seen in router mode).
Runnable guard: src/test/cpp/test_native_server_shutdown.cpp. Applies after 0001.

Refreshed at b11881: #31113 split llama_server() into one function per role (server_run_router,
server_run_instance, server_run_download) and added server_run_opts. The embedded mode now clears
server_run_opts::install_signal_handlers (upstream's own switch, which llama-cli uses) instead of
guarding the sigaction block, and each role function that installs a shutdown handler declares the
reset after the last local its handler captures: models_routes in the router, ctx_http in the
instance.

diff --git a/tools/server/server.cpp b/tools/server/server.cpp
index cf9a4045b..2fa87673c 100644
--- a/tools/server/server.cpp
+++ b/tools/server/server.cpp
@@ -16,6 +16,7 @@
 #include <atomic>
 #include <clocale>
 #include <exception>
+#include <mutex>
 #include <signal.h>
 #include <thread> // for std::thread::hardware_concurrency
 
@@ -26,6 +27,53 @@
 static std::function<void(int)> shutdown_handler;
 static std::atomic_flag is_terminating = ATOMIC_FLAG_INIT;
 
+// [jllama] Embedded-mode support: when llama_server() is hosted inside libjllama and driven over
+// JNI (net.ladenthin.llama.server.NativeServer), it must NOT install process-wide signal handlers
+// (that would hijack the JVM's SIGINT/SIGTERM), and it must be stoppable out-of-band because
+// ctx_server is local to the role function. It also parses exactly the forwarded argv rather than
+// re-deriving it from the process command line (which would be java.exe's — the Windows bug the
+// 0001 patch fixes for the embedded path). These symbols are declared in
+// src/main/cpp/native_server_bridge.h and called by native_server.cpp.
+static std::atomic<bool> g_llama_server_embedded{false};
+
+void llama_server_set_embedded(bool embedded) {
+    g_llama_server_embedded.store(embedded);
+}
+
+// [jllama] shutdown_handler captures the role function's locals by reference and upstream never
+// clears it, so a request that lands after llama_server() returned ran it over destroyed objects
+// (SIGSEGV in server_http_context::stop(), seen in RouterModeIntegrationTest's tearDown). The JNI
+// caller signals repeatedly until the server has returned, so that window is routinely hit. Two
+// guards close it: every write of the handler and every invocation from another thread holds this
+// mutex, and a llama_server_shutdown_handler_reset declared after the captured locals clears the
+// handler before any of them is destroyed. The handler is invoked under the lock, so the reset --
+// and therefore the destruction of what it captures -- waits for an invocation in progress.
+static std::mutex g_shutdown_handler_mutex;
+
+static void llama_server_set_shutdown_handler(std::function<void(int)> handler) {
+    std::lock_guard<std::mutex> lock(g_shutdown_handler_mutex);
+    shutdown_handler = std::move(handler);
+}
+
+struct llama_server_shutdown_handler_reset {
+    llama_server_shutdown_handler_reset() = default;
+    llama_server_shutdown_handler_reset(const llama_server_shutdown_handler_reset &) = delete;
+    llama_server_shutdown_handler_reset & operator=(const llama_server_shutdown_handler_reset &) = delete;
+    ~llama_server_shutdown_handler_reset() {
+        llama_server_set_shutdown_handler(nullptr);
+    }
+};
+
+void llama_server_request_shutdown() {
+    // Mirrors the SIGTERM path: invoke the installed shutdown_handler, which unblocks
+    // ctx_server.start_loop() (instance) / ctx_http.stop() (router). No-op if the server has not
+    // finished starting (handler not yet installed) or has already returned (handler reset).
+    std::lock_guard<std::mutex> lock(g_shutdown_handler_mutex);
+    if (shutdown_handler) {
+        shutdown_handler(SIGTERM);
+    }
+}
+
 static inline void signal_handler(int signal) {
     if (is_terminating.test_and_set()) {
         // in case it hangs, we can force terminate the server by hitting Ctrl+C twice
@@ -447,6 +495,9 @@ static int server_run_router(common_params & params, int argc, char ** argv, con
 
     // setup server instances manager
     std::optional<server_models_routes> models_routes;
+    // [jllama] declared after every local the shutdown handler captures (models_routes, ctx_http,
+    // mcp_mgr), so it clears the handler before any of them is destroyed
+    llama_server_shutdown_handler_reset shutdown_handler_reset;
     try {
         models_routes.emplace(params, argc, argv);
     } catch (const std::exception & e) {
@@ -522,14 +573,14 @@ static int server_run_router(common_params & params, int argc, char ** argv, con
     }
     ctx_http.is_ready.store(true);
 
-    shutdown_handler = [&](int) {
+    llama_server_set_shutdown_handler([&](int) {
         if (models_routes.has_value()) {
             // important to disconnect any SSE clients
             models_routes->stopping.store(true);
         }
         mcp_mgr.shutdown();
         ctx_http.stop();
-    };
+    });
 
     try {
         models_routes->models.load_startup_models();
@@ -590,6 +641,9 @@ static int server_run_instance(common_params & params, server_role & role, commo
     server_tools   tools;
 
     server_http_context ctx_http;
+    // [jllama] declared after every local the shutdown handler captures (ctx_server, mcp_mgr), so
+    // it clears the handler before any of them is destroyed
+    llama_server_shutdown_handler_reset shutdown_handler_reset;
     if (!ctx_http.init(params)) {
         SRV_ERR("%s", "failed to initialize HTTP server\n");
         return 1;
@@ -642,11 +696,11 @@ static int server_run_instance(common_params & params, server_role & role, commo
 
     SRV_INF("%s", "model loaded\n");
 
-    shutdown_handler = [&](int) {
+    llama_server_set_shutdown_handler([&](int) {
         mcp_mgr.shutdown();
         // this will unblock start_loop()
         ctx_server.terminate();
-    };
+    });
 
     if (opts.install_signal_handlers) {
         server_install_signal_handlers();
@@ -743,7 +797,14 @@ int llama_server(int argc, char ** argv) {
     // touch it. lifecycle is symmetric, stop_gc() runs in clean_up() before backend free
     server_stream_session_manager_start();
 
-    if (!common_params_parse_main(argc, argv, params, LLAMA_EXAMPLE_SERVER)) {
+    // [jllama] embedded (JNI) callers forward a clean UTF-8 argv, so honor it exactly via
+    // common_params_parse; only the standalone tool needs common_params_parse_main's
+    // process-command-line (GetCommandLineW) UTF-8 recovery.
+    const bool embedded = g_llama_server_embedded.load();
+    const bool parsed_ok = embedded
+        ? common_params_parse(argc, argv, params, LLAMA_EXAMPLE_SERVER)
+        : common_params_parse_main(argc, argv, params, LLAMA_EXAMPLE_SERVER);
+    if (!parsed_ok) {
         return 1;
     }
 
@@ -752,7 +813,11 @@ int llama_server(int argc, char ** argv) {
     llama_backend_init();
     llama_numa_init(params.numa);
 
-    const int result = server_run(params, argc, argv, role, server_run_opts{});
+    server_run_opts opts;
+    // [jllama] no process-wide SIGINT/SIGTERM handlers when embedded in the JVM (they would hijack
+    // the JVM's own); NativeServer stops the embedded server via llama_server_request_shutdown()
+    opts.install_signal_handlers = !embedded;
+    const int result = server_run(params, argc, argv, role, opts);
     common_log_flush(common_log_main());
     return result;
 }
