+// State of the one embedding server. Peer sockets are registered before their blocking caps
+// handshake, and kept weakly so COMM_FREE/client disconnect still release them immediately.
+static std::mutex                         g_rpc_server_mutex;
+static std::atomic<bool>                  g_rpc_server_stop{false};
+static std::atomic<bool>                  g_rpc_server_listening{false};
+static socket_ptr                         g_rpc_server_client;
+static std::vector<std::weak_ptr<socket_t>> g_rpc_server_peers;
+
+static bool rpc_server_track_peer(const socket_ptr & peer) {
+    std::lock_guard<std::mutex> lock(g_rpc_server_mutex);
+    if (g_rpc_server_stop) {
+        peer->shutdown();
+        return false;
+    }
+    for (auto it = g_rpc_server_peers.begin(); it != g_rpc_server_peers.end();) {
+        if (it->expired()) {
+            it = g_rpc_server_peers.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    g_rpc_server_peers.push_back(peer);
+    return true;
+}
