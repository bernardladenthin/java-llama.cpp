+static bool set_nonblocking(sockfd_t fd, bool enabled) {
+#ifdef _WIN32
+    u_long mode = enabled ? 1 : 0;
+    return ioctlsocket(fd, FIONBIO, &mode) == 0;
+#else
+    const int flags = fcntl(fd, F_GETFL, 0);
+    return flags >= 0 && fcntl(fd, F_SETFL, enabled ? flags | O_NONBLOCK : flags & ~O_NONBLOCK) == 0;
+#endif
+}
+
+static bool socket_would_block() {
+#ifdef _WIN32
+    const int error = WSAGetLastError();
+    return error == WSAEWOULDBLOCK || error == WSAEINPROGRESS;
+#else
+    return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINPROGRESS;
+#endif
+}
+
+// poll/WSAPoll work for high-numbered JVM descriptors too, unlike FD_SET/select on POSIX.
+static bool wait_socket(sockfd_t fd, bool write, const std::atomic<bool> * stop) {
+#ifdef _WIN32
+    WSAPOLLFD pending = {};
+#else
+    struct pollfd pending = {};
+#endif
+    pending.fd = fd;
+    pending.events = write ? POLLOUT : POLLIN;
+    while (!stop->load()) {
+#ifdef _WIN32
+        const int ready = WSAPoll(&pending, 1, 50);
+        if (ready < 0 && WSAGetLastError() == WSAEINTR) {
+            continue;
+        }
+#else
+        const int ready = poll(&pending, 1, 50);
+        if (ready < 0 && errno == EINTR) {
+            continue;
+        }
+#endif
+        if (ready < 0 || (pending.revents & POLLNVAL)) {
+            return false;
+        }
+        if (ready > 0) {
+            return !stop->load();
+        }
+    }
+    return false;
+}
