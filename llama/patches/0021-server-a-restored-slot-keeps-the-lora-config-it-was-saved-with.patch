+    // the lora config of every slot file this server saved, by path: a slot file does not store it
+    std::map<std::string, std::vector<common_adapter_lora_info>> slot_file_lora;
+
     // note: keep these alive - they determine the lifetime of the model, context, etc.
     common_init_result_ptr llama_init;
 
@@ -3229,6 +3232,8 @@ private:
                         break;
                     }
 
+                    slot_file_lora[filepath] = slot->prompt.lora;
+
                     const int64_t t_end = ggml_time_us();
                     const double t_save_ms = (t_end - t_start) / 1000.0;
 
@@ -3288,6 +3293,12 @@ private:
 
                         slot->prompt.clear();
                         slot->prompt.tokens = std::move(restored);
+                        // the lora config the state was saved with; a file this server did not save
+                        // counts as computed under none, so the first task with adapters clears it
+                        const auto saved_lora = slot_file_lora.find(filepath);
+                        slot->prompt.lora = saved_lora != slot_file_lora.end()
+                            ? saved_lora->second
+                            : std::vector<common_adapter_lora_info>{};
                     } catch (const std::exception & err) {
