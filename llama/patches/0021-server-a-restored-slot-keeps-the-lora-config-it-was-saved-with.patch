+    // adapter infos: a wake from the idle sleep loads the adapters again, under new pointers
+    std::map<std::string, std::vector<float>> slot_file_lora;
+
     // note: keep these alive - they determine the lifetime of the model, context, etc.
     common_init_result_ptr llama_init;
 
@@ -3208,6 +3213,9 @@ private:
                     std::string filename = task.slot_action.filename;
                     std::string filepath = task.slot_action.filepath;
 
+                    // the file is rewritten below: until the save completes it has no known config
+                    slot_file_lora.erase(filepath);
+
                     std::vector<char> packed;
                     try {
                         packed = slot->prompt.tokens.serialize();
@@ -3237,6 +3245,11 @@ private:
                         break;
                     }
 
+                    std::vector<float> & scales = slot_file_lora[filepath];
+                    for (const auto & lora : slot->prompt.lora) {
+                        scales.push_back(lora.scale);
+                    }
+
                     const int64_t t_end = ggml_time_us();
                     const double t_save_ms = (t_end - t_start) / 1000.0;
 
@@ -3296,6 +3309,17 @@ private:
 
                         slot->prompt.clear();
                         slot->prompt.tokens = std::move(restored);
+                        // the lora config the state was saved with, on the adapters loaded now; a
+                        // file this server did not save counts as computed under none, so the first
+                        // task with adapters clears it
+                        slot->prompt.lora.clear();
+                        const auto saved = slot_file_lora.find(filepath);
+                        if (saved != slot_file_lora.end() && saved->second.size() == params_base.lora_adapters.size()) {
+                            slot->prompt.lora = params_base.lora_adapters;
+                            for (size_t i = 0; i < saved->second.size(); i++) {
+                                slot->prompt.lora[i].scale = saved->second[i];
+                            }
+                        }
                     } catch (const std::exception & err) {
                         slot->prompt_clear();
                         send_error(task, std::string("Unable to restore slot: ") + err.what(), ERROR_TYPE_INVALID_REQUEST);
