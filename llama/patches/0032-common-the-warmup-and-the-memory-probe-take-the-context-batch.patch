-            tmp.resize(std::min(tmp.size(), (size_t) params.n_batch));
+            // the context's batch, not params.n_batch: a causal context's batch is at most its n_ctx
+            tmp.resize(std::max<size_t>(1, std::min(tmp.size(), (size_t) llama_n_batch(lctx))));
             common_batch batch = common_batch_get_one(lctx, tmp);
             std::vector<float> zeros;
             common_batch_set_zero_state(batch, model, zeros);
@@ -1606,12 +1609,17 @@
     tmp.push_back(0);
