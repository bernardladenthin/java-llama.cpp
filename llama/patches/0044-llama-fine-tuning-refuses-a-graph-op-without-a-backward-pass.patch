+// jllama: ggml_build_backward_expand (ggml/src/ggml.c) ends the process (GGML_ABORT, GGML_ASSERT) when the
+// graph needs a gradient it cannot compute: an op ggml_compute_backward has no case for (MUL_MAT_ID, SSM_SCAN,
+// NORM, the GLU ops, ...), or a source of a supported op it does not differentiate (the softmax mask). Fine-tuning
+// a mixture of experts, a recurrent model or Gemma 4 therefore ended the process that ran it. The two functions
+// below walk the forward graph with the backward pass's own rules -- which nodes need a gradient, which of them get
+// one from the loss -- and name the first node it would fail on, so that opt_epoch can refuse the model instead.
+// The op lists are held to ggml_compute_backward's switch at configure time (java-llama.cpp,
+// llama/cmake/check-backward-ops.cmake); its shape assertions are not mirrored, except MUL_MAT's broadcast and the layouts of the gradients.
+
+// whether ggml_compute_backward has a case for the op of t
+static bool llama_opt_backward_op_supported(const ggml_tensor * t) {
+    switch (t->op) {
+        // jllama-backward-ops-begin
+        case GGML_OP_DUP:
+        case GGML_OP_ADD:
+        case GGML_OP_ACC:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_LOG:
+        case GGML_OP_SIN:
+        case GGML_OP_COS:
+        case GGML_OP_SUM:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_MEAN:
+        case GGML_OP_REPEAT:
+        case GGML_OP_REPEAT_BACK:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_MUL_MAT:
+        case GGML_OP_SCALE:
+        case GGML_OP_SET:
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_TRI:
+        case GGML_OP_SOFT_MAX:
+        case GGML_OP_ROPE:
+        case GGML_OP_IM2COL:
+        case GGML_OP_POOL_2D:
+        case GGML_OP_CROSS_ENTROPY_LOSS:
+        case GGML_OP_CONCAT:
+        case GGML_OP_NONE:
+        // jllama-backward-ops-end
+            return true;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(t)) {
+                // jllama-backward-unary-ops-begin
+                case GGML_UNARY_OP_ABS:
+                case GGML_UNARY_OP_SGN:
+                case GGML_UNARY_OP_NEG:
+                case GGML_UNARY_OP_STEP:
+                case GGML_UNARY_OP_TANH:
+                case GGML_UNARY_OP_RELU:
+                case GGML_UNARY_OP_SILU:
+                case GGML_UNARY_OP_SIGMOID:
+                case GGML_UNARY_OP_EXP:
+                case GGML_UNARY_OP_EXPM1:
+                case GGML_UNARY_OP_SOFTPLUS:
+                // jllama-backward-unary-ops-end
+                    return true;
+                default:
+                    return false;
+            }
+        case GGML_OP_GLU:
+            switch (ggml_get_glu_op(t)) {
+                // jllama-backward-glu-ops-begin
+                case GGML_GLU_OP_SWIGLU:
+                // jllama-backward-glu-ops-end
+                    return true;
+                default:
+                    return false;
+            }
+        default:
+            // WIN_PART and WIN_UNPART share UNARY's case upstream, whose ggml_get_unary_op asserts that the op is UNARY
+            return false;
+    }
+}
+
+// the first node of gf the backward pass from output (the logits the loss is computed from) cannot be built for,
+// with the reason in reason -- or nullptr. Declared in llama-context.h.
+const ggml_tensor * llama_opt_find_unsupported_backward(
+        ggml_cgraph * gf, const ggml_tensor * output, std::string & reason) {
+    const int n_nodes = ggml_graph_n_nodes(gf);
+
+    // a source whose gradient has no effect on the output's: ggml_build_backward_expand does not mark a node through
+    // it, and ggml_compute_backward computes no gradient for it
+    const auto ignored = [](const ggml_tensor * node, int j) {
+        switch (node->op) {
+            case GGML_OP_IM2COL:
+            case GGML_OP_IM2COL_BACK:
+                return j == 0;
+            case GGML_OP_UNARY: {
+                const ggml_unary_op uop = ggml_get_unary_op(node);
+                return j == 0 && (uop == GGML_UNARY_OP_SGN || uop == GGML_UNARY_OP_STEP);
+            }
+            case GGML_OP_CPY:
+            case GGML_OP_GET_ROWS:
+            case GGML_OP_GET_ROWS_BACK:
+            case GGML_OP_ROPE:
+                return j == 1;
+            default:
+                return false;
+        }
+    };
+
+    // the nodes that need a gradient: ggml_build_backward_expand's first loop
+    std::unordered_set<const ggml_tensor *> needs;
+    for (int i = 0; i < n_nodes; ++i) {
+        const ggml_tensor * node = ggml_graph_node(gf, i);
+        if (node->type == GGML_TYPE_I32) {
+            continue;
+        }
+        bool node_needs = (node->flags & GGML_TENSOR_FLAG_PARAM) || (node->flags & GGML_TENSOR_FLAG_LOSS);
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * src = node->src[j];
+            if (src == nullptr || ignored(node, j) || needs.count(src) == 0) {
+                continue;
+            }
+            if (src->type != GGML_TYPE_F32 && src->type != GGML_TYPE_F16) {
+                reason = format("the gradient of '%s' (%s) is needed and its type is %s", src->name,
+                        ggml_op_desc(src), ggml_type_name(src->type));
+                return node;
+            }
+            node_needs = true;
+            break;
+        }
+        if (!node_needs) {
+            continue;
+        }
+        if (node->view_src != nullptr && node->op != GGML_OP_CPY && node->op != GGML_OP_SET_ROWS &&
+                node->op != GGML_OP_VIEW && node->op != GGML_OP_RESHAPE && node->op != GGML_OP_PERMUTE &&
+                node->op != GGML_OP_TRANSPOSE) {
+            reason = format("'%s' (%s) is an in-place operation, which ggml cannot differentiate", node->name,
+                    ggml_op_desc(node));
+            return node;
+        }
+        needs.insert(node);
+    }
+
+    // the layout of each gradient as ggml_compute_backward builds it, in elements: the first gradient a node gets
+    // is what its consumer hands over -- for DUP, ADD, ACC, SUB and CONT the consumer's own, permuted for PERMUTE
+    // and TRANSPOSE -- while a second one is added into a new, contiguous tensor, as the accumulators of the
+    // parameters and the loss are, and every other backward builds a new tensor. The layout matters where the
+    // backward asserts it: CONCAT, ACC and SET view their gradient with explicit strides (ggml_view_4d asserts
+    // that its first stride is the element's), CPY, CONT and SET reshape or accumulate into it (contiguous only),
+    // and CONT and VIEW accumulate into the gradient their source has so far.
+    struct grad_layout {
+        int64_t ne[GGML_MAX_DIMS];
+        int64_t nb[GGML_MAX_DIMS];
+    };
+    const auto contiguous_layout = [](const ggml_tensor * t) {
+        grad_layout l;
+        int64_t stride = 1;
+        for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+            l.ne[d] = t->ne[d];
+            l.nb[d] = stride;
+            stride *= t->ne[d];
+        }
+        return l;
+    };
+    const auto is_contiguous = [](const grad_layout & l) { // ggml_is_contiguous, in elements
+        if (l.ne[0] != 1 && l.nb[0] != 1) {
+            return false;
+        }
+        int64_t next = l.ne[0];
+        for (int d = 1; d < GGML_MAX_DIMS; ++d) {
+            if (l.ne[d] != 1) {
+                if (l.nb[d] != next) {
+                    return false;
+                }
+                next *= l.ne[d];
+            }
+        }
+        return true;
+    };
+    std::unordered_map<const ggml_tensor *, grad_layout> layouts;
+    const auto layout_of = [&](const ggml_tensor * t) {
+        const auto it = layouts.find(t);
+        return it != layouts.end() ? it->second : contiguous_layout(t);
+    };
+    // what the backward of node hands source j, given the layout l of node's own gradient
+    const auto handed_over = [&](const ggml_tensor * node, int j, const grad_layout & l) {
+        const ggml_tensor * src = node->src[j];
+        switch (node->op) {
+            case GGML_OP_DUP:
+            case GGML_OP_ACC:
+            case GGML_OP_SUB:
+                return j == 0 ? l : contiguous_layout(src);
+            case GGML_OP_ADD:
+                return j == 0 || ggml_are_same_shape(node->src[0], src) ? l : contiguous_layout(src);
+            case GGML_OP_CONT:
+                return ggml_are_same_shape(node, src) ? l : contiguous_layout(src);
+            case GGML_OP_TRANSPOSE: {
+                grad_layout t = l;
+                std::swap(t.ne[0], t.ne[1]);
+                std::swap(t.nb[0], t.nb[1]);
+                return t;
+            }
+            case GGML_OP_PERMUTE: {
+                // the gradient is permuted back: axis d of the source is axis axes[d] of the node
+                const int32_t * axes = (const int32_t *) node->op_params;
+                grad_layout p;
+                for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+                    p.ne[d] = l.ne[axes[d] & 0x3];
+                    p.nb[d] = l.nb[axes[d] & 0x3];
+                }
+                return p;
+            }
+            default:
+                return contiguous_layout(src);
+        }
+    };
+
+    // the nodes that get a gradient: the output, through the loss, and the parameters, which have accumulators;
+    // ggml_compute_backward visits them in reverse order and differentiates src[0..2]
+    std::unordered_set<const ggml_tensor *> has;
+    if (needs.count(output) != 0) {
+        has.insert(output);
+    }
+    for (const ggml_tensor * node : needs) {
+        if ((node->flags & GGML_TENSOR_FLAG_PARAM) || (node->flags & GGML_TENSOR_FLAG_LOSS)) {
+            has.insert(node);
+        }
+    }
+    for (int i = n_nodes - 1; i >= 0; --i) {
+        const ggml_tensor * node = ggml_graph_node(gf, i);
+        if (has.count(node) == 0) {
+            continue;
+        }
+        if (!llama_opt_backward_op_supported(node)) {
+            reason = format("ggml has no backward pass for %s (tensor '%s')", ggml_op_desc(node), node->name);
+            return node;
+        }
+        if (node->op == GGML_OP_MUL_MAT && (node->src[2] != nullptr || node->src[3] != nullptr)) {
+            // the scales of a matmul (b12818): ggml_compute_backward differentiates src[0] and src[1] as if both
+            // scales were 1, so every gradient through the weight would be off by its scale
+            reason = format("ggml's backward pass of MUL_MAT ignores the scale of its weight (tensor '%s')",
+                    node->name);
+            return node;
+        }
+        {
+            const grad_layout l = layout_of(node);
+            const bool src0_needs = node->src[0] != nullptr && needs.count(node->src[0]) != 0;
+            const bool src1_needs = node->src[1] != nullptr && needs.count(node->src[1]) != 0;
+            const bool views = (node->op == GGML_OP_CONCAT && (src0_needs || src1_needs)) ||
+                               (node->op == GGML_OP_ACC && src1_needs) ||
+                               (node->op == GGML_OP_SET && (src0_needs || src1_needs));
+            const bool reshapes = ((node->op == GGML_OP_CPY || node->op == GGML_OP_CONT || node->op == GGML_OP_SET) &&
+                                   src0_needs);
+            if ((views && l.nb[0] != 1) || (reshapes && !is_contiguous(l))) {
+                reason = format("ggml's backward pass of %s cannot take its gradient as the transposed or permuted "
+                        "view it arrives as (tensor '%s')", ggml_op_desc(node), node->name);
+                return node;
+            }
+            if ((node->op == GGML_OP_CONT || node->op == GGML_OP_VIEW) && src0_needs && has.count(node->src[0]) != 0 &&
+                    !is_contiguous(layout_of(node->src[0]))) {
+                reason = format("ggml's backward pass of %s cannot add to the transposed or permuted gradient of "
+                        "'%s' (tensor '%s')", ggml_op_desc(node), node->src[0]->name, node->name);
+                return node;
+            }
+        }
+        for (int j = 0; j < 3; ++j) {
+            const ggml_tensor * src = node->src[j];
+            if (src == nullptr || needs.count(src) == 0) {
+                continue;
+            }
+            const bool asserted = (node->op == GGML_OP_SOFT_MAX && j == 1) || (node->op == GGML_OP_ROPE && j == 2) ||
+                                  (node->op == GGML_OP_CROSS_ENTROPY_LOSS && j == 1) ||
+                                  (node->op == GGML_OP_GLU && j == 0 && node->src[1] == nullptr) ||
+                                  (node->op == GGML_OP_MUL_MAT && j == 0 &&
+                                   (src->ne[2] != node->src[1]->ne[2] || src->ne[3] != node->src[1]->ne[3]) &&
+                                   node->src[1]->ne[3] != 1);
+            if (asserted) {
+                reason = format("ggml has no backward pass for source %d of %s (tensor '%s')", j, ggml_op_desc(node),
+                        node->name);
+                return node;
+            }
+            if (ignored(node, j) || (node->op == GGML_OP_SOFT_MAX && j == 2)) {
+                // no gradient for this source here; ggml_compute_backward asserts that it has one already
+                if (has.count(src) == 0) {
+                    reason = format("ggml computes no gradient for source %d of %s (tensor '%s')", j,
+                            ggml_op_desc(node), node->name);
+                    return node;
+                }
+                continue;
+            }
+            // a second gradient is added into a new tensor; the accumulators of the parameters and the loss, and
+            // the output's gradient from the loss, are contiguous from the start
+            layouts[src] = has.count(src) == 0 ? handed_over(node, j, layout_of(node)) : contiguous_layout(src);
+            has.insert(src);
+        }
+    }
+    return nullptr;
+}
