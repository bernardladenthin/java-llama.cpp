+                if (!ctx.is_lenient()) {
+                    return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_FAIL, start_pos);
+                }
+                // Lenient: keep what was scanned before the malformed byte instead of failing the
+                // whole parse, mirroring the INCOMPLETE branch above. Failing here loses a result
+                // that was produced successfully: common_chat_peg_parse() always parses in lenient
+                // mode, and the server runs it over every completion (content-only when the request
+                // configures no chat parser), so a single stray byte anywhere in the generated text
+                // turns a finished generation into an HTTP 500 instead of a response.
+                return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_NEED_MORE_INPUT, start_pos, last_valid_pos);
             }
 
