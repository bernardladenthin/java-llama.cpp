 #include <cstring>
 #include <cassert>
 #include <cstdio>  // for GGML_ASSERT
+#include <atomic>
+#include <cstdlib>
 
 #include "repack.h"
 
+// MUL_MAT_ID over repacked weights: batched (work units + gemm) or one gemv per token, see
+// ggml_backend_cpu_set_repack_mmid_batched in ggml-cpu.h
+static std::atomic<bool> & repack_mmid_batched() {
+    static std::atomic<bool> batched{[] {
+        const char * env = std::getenv("GGML_CPU_REPACK_MMID_BATCHED");
+        return env == nullptr || strcmp(env, "0") != 0;
+    }()};
+    return batched;
+}
+
+void ggml_backend_cpu_set_repack_mmid_batched(bool batched) {
+    repack_mmid_batched().store(batched);
+}
+
+bool ggml_backend_cpu_get_repack_mmid_batched(void) {
+    return repack_mmid_batched().load();
+}
+
