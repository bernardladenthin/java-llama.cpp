					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>vulkan-windows-x86-64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>vulkan-windows-aarch64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>vulkan-windows-aarch64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>opencl-android-aarch64</id>
			<dependencies>
