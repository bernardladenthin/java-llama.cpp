					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>opencl-android-aarch64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>opencl-windows-x86-64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>opencl-windows-x86-64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>opencl-windows-aarch64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>opencl-windows-aarch64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>rocm-linux-x86-64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>rocm-linux-x86-64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>rocm-windows-x86-64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>rocm-windows-x86-64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>sycl-linux-x86-64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
					<classifier>sycl-linux-x86-64</classifier>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>sycl-windows-x86-64</id>
			<dependencies>
				<dependency>
					<groupId>net.ladenthin</groupId>
					<artifactId>llama</artifactId>
					<version>${llama.version}</version>
